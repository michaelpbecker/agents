# Agent-Specific Environment Variables
#
# Copy the variables you need to the main .env file in the repository root.
# These are examples - customize for your agent.

# API Keys
YOUR_API_KEY=your_api_key_here
YOUR_API_SECRET=your_api_secret_here

# Agent Configuration
YOUR_SETTING=value
YOUR_THRESHOLD=10

# Optional: If your agent needs Slack
# SLACK_BOT_TOKEN=xoxb-your-token
# SLACK_CHANNEL_ID=C1234567890

# Optional: If your agent needs Mode Analytics
# MODE_API_TOKEN=your_token
# MODE_API_SECRET=your_secret
# MODE_WORKSPACE=workspace_name
# MODE_REPORT_ID=report_id
